#===============================================================================
#  zff — x86_64 Builder Dockerfile (Ubuntu 24.04 LTS)
#===============================================================================

FROM ubuntu:24.04 AS deps

ENV DEBIAN_FRONTEND=noninteractive

# ── Base toolchain ────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    ca-certificates \
    curl \
    git \
    zip \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# ── FFmpeg libraries & Pro-AV dependencies ───────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    libavformat-dev \
    libavcodec-dev \
    libavfilter-dev \
    libavutil-dev \
    libavdevice-dev \
    libswscale-dev \
    libswresample-dev \
    ffmpeg \
    libasound2-dev \
    libv4l-dev \
    libdrm-dev \
    libgl1-mesa-dev \
    libglx-dev \
    libx11-dev \
    libxext-dev \
    xvfb \
    libssl-dev \
    libsrt-gnutls-dev \
    libfreetype-dev \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# ── Debugging & validation tools ─────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb \
    valgrind \
    strace \
    patch \
    && rm -rf /var/lib/apt/lists/*

# ── libdatachannel (WebRTC) with zff TWCC interceptor patch ─────────────────
# Mirrors zstreamer: outgoing track interceptors needed for TWCC sender-side
# (transport-cc injection + RTCP CCFB processing in zstr_webrtc_twcc).
COPY scripts/libdatachannel-twcc.patch /tmp/
RUN cd /tmp && \
    git clone --depth 1 --recurse-submodules --shallow-submodules \
        https://github.com/paullouisageneau/libdatachannel.git && \
    cd libdatachannel && \
    patch -p1 < /tmp/libdatachannel-twcc.patch && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DENABLE_TESTS=OFF -DENABLE_EXAMPLES=OFF \
             -DENABLE_MEDIA=ON -DENABLE_DATACHANNELS=ON \
             -DCMAKE_INSTALL_PREFIX=/usr/local && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    rm -rf /tmp/libdatachannel /tmp/libdatachannel-twcc.patch

WORKDIR /workspace

# ── Interactive developer image ──────────────────────────────────────────────
FROM deps AS dev
CMD ["/bin/bash"]

# ── Standalone CI verification image ─────────────────────────────────────────
FROM deps AS ci
COPY . /workspace
RUN mkdir -p /workspace/build && cd /workspace/build && \
    cmake -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=ON .. && \
    ninja
WORKDIR /workspace/build
CMD ["ctest", "--output-on-failure"]
